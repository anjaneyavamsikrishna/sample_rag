# Copy this file to a new file named exactly  .env  and edit the values.
# Rules: one NAME=value per line, no spaces around "=", no quotes, lines starting with # are comments.

# Embedding model (Task 4)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Reranker and retrieval (Task 6)
RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVE_K=20
TOP_K=5
# Minimum reranker score (0..1) to accept a chunk as evidence. Calibrate with: python calibrate_threshold.py
MIN_RERANK_SCORE=0.05

# Conversation memory (Task 8): how many recent messages are used to understand follow-ups
HISTORY_MESSAGES=6

# API (Task 10): if set, every request except /health must send header  X-API-Key: <this value>
API_KEY=

# Vector database (Task 5). Leave QDRANT_URL empty to store data in the local folder.
QDRANT_PATH=./qdrant_data
QDRANT_URL=

# LLM (Task 7). Put your real key here, in .env only. Never in code, never in git.
OPENAI_API_KEY=your_api_key_here
LLM_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=
